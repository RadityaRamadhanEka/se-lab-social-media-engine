{
  "name": "se-lab-video-studio",
  "version": "1.0.0",
  "description": "Remotion 3D Storytelling Video Engine for @se.lab.filkom (FILKOM UB)",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "gen:vo": "node scripts/generate-vo-id.mjs",
    "gen:audio-kit": "node scripts/generate-audio-kit.mjs",
    "render:rpl": "remotion render src/index.ts ApaItuRpl3D out/apa-itu-rpl.mp4 --gl=angle --concurrency=2",
    "render:rpl:dark": "remotion render src/index.ts ApaItuRpl3D out/apa-itu-rpl-dark.mp4 --props='{\"theme\":\"dark\"}' --gl=angle --concurrency=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/three": "4.0.545",
    "msedge-tts": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.545",
    "three": "^0.169.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config": "4.0.545",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
